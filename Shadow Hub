local instantClickOriginais = {}
local instantClickConnection

local function aplicarInstantClick(obj)
    if not Config.InstantClick then return end
    if obj:IsA("ProximityPrompt") then
        if not instantClickOriginais[obj] then
            instantClickOriginais[obj] = {
                HoldDuration = obj.HoldDuration,
                RequiresLineOfSight = obj.RequiresLineOfSight
            }
        end
        pcall(function()
            obj.HoldDuration = 0
            obj.RequiresLineOfSight = false
        end)
    end
end

local function ligarInstantClick()
    for _, obj in ipairs(workspace:GetDescendants()) do
        aplicarInstantClick(obj)
    end
    if not instantClickConnection then
        instantClickConnection = workspace.DescendantAdded:Connect(function(obj)
            if Config.InstantClick then aplicarInstantClick(obj) end
        end)
    end
end

local function desligarInstantClick()
    for obj, original in pairs(instantClickOriginais) do
        if obj and obj.Parent and obj:IsA("ProximityPrompt") then
            pcall(function()
                obj.HoldDuration = original.HoldDuration
                obj.RequiresLineOfSight = original.RequiresLineOfSight
            end)
        end
        instantClickOriginais[obj] = nil
    end
end

local function setInstantClick(enabled)
    Config.InstantClick = enabled
    if enabled then
        ligarInstantClick()
    else
        desligarInstantClick()
    end
end

