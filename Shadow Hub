local function calcValue(rec)
    if not AssetsEarnings then
        return 0
    end

    local baseRate = 0
    local d = AssetsDir and AssetsDir[rec.AssetCategory]

    if d then
        if d.Egg and tonumber(d.Egg.Earnings) then
            baseRate = tonumber(d.Egg.Earnings)
        elseif tonumber(d.Earnings) then
            baseRate = tonumber(d.Earnings)
        elseif tonumber(d.BaseRate) then
            baseRate = tonumber(d.BaseRate)
        end
    end

    if baseRate == 0 then
        local item = {
            Category = rec.AssetCategory,
            Scale = tonumber(rec.AssetScale) or 1,
            Mutations = rec.Mutations or {}
        }

        local ok, value = pcall(
            AssetsEarnings.LiveRatePerSecond,
            item,
            nil,
            nil,
            localPlayer
        )

        if ok and type(value) == "number" and value > 0 then
            return value
        end
    end

    local scale = tonumber(rec.AssetScale) or 1
    local total = baseRate * scale

    local mutations = rec.Mutations or {}
    local multiplier = 1

    for _, mutation in pairs(mutations) do
        if type(mutation) == "table" and tonumber(mutation.Multiplier) then
            multiplier *= tonumber(mutation.Multiplier)
        elseif type(mutation) == "string" then
            local mutData = AssetsDir and AssetsDir[mutation]
            if mutData and tonumber(mutData.Multiplier) then
                multiplier *= tonumber(mutData.Multiplier)
            end
        end
    end

    return total * multiplier
end

local function displayName(cat)
    local d = AssetsDir and AssetsDir[cat]
    return (d and d.DisplayName) or cat or "?"
end

local function rarityOf(cat)
    local d = AssetsDir and AssetsDir[cat]
    if d and d.Rarity then
        return d.Rarity.DisplayName or d.Rarity._id or "?"
    end
    return "?"
end

local function rarityColorOf(cat)
    local d = AssetsDir and AssetsDir[cat]
    if d and d.Rarity and typeof(d.Rarity.Color) == "Color3" then
        return d.Rarity.Color
    end
    return Color3.fromRGB(200, 200, 200)
end

local function iconOf(cat)
    local d = AssetsDir and AssetsDir[cat]
    if type(d) ~= "table" then return nil end

    if d.Icon and d.Icon ~= "" then
        local s = tostring(d.Icon)
        if tonumber(s) then return "rbxassetid://" .. s end
        if s:find("rbxassetid") then return s end
    end

    if type(d.Egg) == "table" and d.Egg.Icon and d.Egg.Icon ~= "" then
        local s = tostring(d.Egg.Icon)
        if tonumber(s) then return "rbxassetid://" .. s end
        if s:find("rbxassetid") then return s end
    end

    return nil
end

local function rateFormat(n)
    n = tonumber(n) or 0
    local units = {
        {1e12, "T"},
        {1e9, "B"},
        {1e6, "M"},
        {1e3, "K"}
    }

    for _, u in ipairs(units) do
        if n >= u[1] then
            local value = n / u[1]
            local txt
            if value < 10 then
                txt = string.format("%.2f", value)
            else
                txt = string.format("%.1f", value)
            end
            txt = txt:gsub("%.?0+$", "")
            return txt .. u[2]
        end
    end

    return tostring(math.floor(n))
end

