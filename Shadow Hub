-- LISTA DE OVOS (FILTRO LEVE)
-- ============================================================
local stolen = {}
local unreachable = {}
local STOLEN_FOR = 120
local UNREACHABLE_FOR = 45

local function pruneStolen()
    local now = os.clock()
    for uid, at in pairs(stolen) do
        if (now - at) > STOLEN_FOR then stolen[uid] = nil end
    end
    for uid, at in pairs(unreachable) do
        if (now - at) > UNREACHABLE_FOR then unreachable[uid] = nil end
    end
end

local function listEggs(incluirBase)
    if not EggState or type(EggState.ReadFieldEggs) ~= "function" then return {} end
    local ok, data = pcall(EggState.ReadFieldEggs)
    if not ok or type(data) ~= "table" or type(data.Records) ~= "table" then return {} end

    pruneStolen()

    local placedRenders = workspace:FindFirstChild("PlacedEggRenders")

    local out = {}
    local vistos = {}
    for _, rec in pairs(data.Records) do
        if type(rec) == "table" and rec.Uid and rec.AssetCategory then
            local uid = tostring(rec.Uid)
            if not vistos[uid] then
                local pos = nil
                if rec.BoundsCFrame and rec.BoundsCFrame.Position then
                    pos = rec.BoundsCFrame.Position
                elseif rec.CFrame and rec.CFrame.Position then
                    pos = rec.CFrame.Position
                elseif rec.Position then
                    pos = rec.Position
                end

                local state = tostring(rec.State or "?")
                local carregado = rec.CarrierUserId ~= nil and rec.CarrierUserId ~= 0
                local valido = (state ~= "Carried" and state ~= "Inventory" and state ~= "Base" and not carregado and pos ~= nil)

                if valido and stolen[uid] then valido = false end
                if valido and unreachable[uid] then valido = false end

                if valido then
                    vistos[uid] = true
                    out[#out + 1] = {
                        uid   = uid,
                        state = state,
                        pos   = pos,
                        value = calcValue(rec),
                        cat   = rec.AssetCategory,
                        name  = displayName(rec.AssetCategory),
                        rarity = rarityOf(rec.AssetCategory),
                        color = rarityColorOf(rec.AssetCategory),
                        icon  = iconOf(rec.AssetCategory),
                        kg    = weightOf(rec),
                        isBase = false,
                    }
                end
            end
        end
    end

    if incluirBase and type(EggState.ReadOwnerEggs) == "function" then
        if placedRenders then
            local okOwn, ownerEggs = pcall(EggState.ReadOwnerEggs, LocalPlayer.UserId)
            if okOwn and type(ownerEggs) == "table" then
                for uid, rec in pairs(ownerEggs) do
                    if type(rec) == "table" and rec.Placement ~= nil and rec.AssetCategory then
                        local model = nil
                        for _, ch in ipairs(placedRenders:GetChildren()) do
                            if string.find(ch.Name, tostring(uid), 1, true) then
                                model = ch
                                break
                            end
                        end
                        if model then
                            local pos
                            pcall(function()
                                pos = model:IsA("Model") and model:GetPivot().Position or model.CFrame.Position
                            end)
                            if pos then
                                out[#out + 1] = {
                                    uid   = "base_" .. tostring(uid),
                                    state = "Base",
                                    pos   = pos,
                                    value = calcValue(rec),
                                    cat   = rec.AssetCategory,
                                    name  = displayName(rec.AssetCategory),
                                    rarity = rarityOf(rec.AssetCategory),
                                    color = rarityColorOf(rec.AssetCategory),
                                    icon  = iconOf(rec.AssetCategory),
                                    kg    = weightOf(rec),
                                    isBase = true,
                                }
                            end
                        end
                    end
                end
            end
        end
    end
    table.sort(out, function(a, b) return a.value > b.value end)
    return out
end

local function acharOvoPorUid(uid)
    for _, e in ipairs(listEggs(false)) do
        if e.uid == uid then return e end
    end
    return nil
end

local function acharOvoMesmoTipoPerto(cat, posJogador, raio)
    raio = raio or 30
    local list = listEggs(false)
    local maisPerto, menorDist = nil, raio
    for _, e in ipairs(list) do
        if e.cat == cat and e.pos then
            local d = (e.pos - posJogador).Magnitude
            if d < menorDist then
                menorDist = d
                maisPerto = e
            end
        end
    end
    return maisPerto
end

local function estaSegurandoOvoAPI()
    if not EggState or type(EggState.ReadFieldEggs) ~= "function" then return false end
    local ok, data = pcall(EggState.ReadFieldEggs)
    if not ok or type(data) ~= "table" or type(data.Records) ~= "table" then return false end
    for _, rec in pairs(data.Records) do
        if type(rec) == "table" and rec.State == "Carried" then
            local dono = tonumber(rec.CarrierUserId)
            if dono == LocalPlayer.UserId then
                return true, tostring(rec.Uid)
            end
        end
    end
    return false
end

local function estaSegurandoOvoWeld()
    local uid = Carregando.Uid
    if type(uid) ~= "string" or uid == "" then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local obj = workspace:FindFirstChild(uid)
    if not obj then return false end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("WeldConstraint") or d:IsA("JointInstance") or d:IsA("RigidConstraint") then
            local ok, p0, p1 = pcall(function() return d.Part0, d.Part1 end)
            if ok then
                if (p0 and p0:IsDescendantOf(char)) or (p1 and p1:IsDescendantOf(char)) then
                    return true
                end
            end
        end
    end
    return false
end

local function estaSegurandoOvo()
    local api, uid = estaSegurandoOvoAPI()
    if api then return true, uid end
    if Carregando.IsCarrying and Carregando.Uid then
        local obj = workspace:FindFirstChild(Carregando.Uid)
        if obj then
            local char = LocalPlayer.Character
            if char then
                for _, d in ipairs(obj:GetDescendants()) do
                    if d:IsA("WeldConstraint") or d:IsA("JointInstance") or d:IsA("RigidConstraint") then
                        local ok2, p0, p1 = pcall(function() return d.Part0, d.Part1 end)
                        if ok2 then
                            if (p0 and p0:IsDescendantOf(char)) or (p1 and p1:IsDescendantOf(char)) then
                                return true, Carregando.Uid
                            end
                        end
                    end
                end
            end
        end
    end
    if estaSegurandoOvoWeld() then return true, Carregando.Uid end
    return false
end

