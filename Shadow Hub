local espFolder = Instance.new("Folder")
espFolder.Name = "ShadowESP"
espFolder.Parent = workspace

local espCards = {}

local function clearESP()
    for _, card in pairs(espCards) do
        pcall(function() if card.highlight then card.highlight:Destroy() end end)
        pcall(function() if card.holder then card.holder:Destroy() end end)
    end
    espCards = {}

    for _, child in ipairs(espFolder:GetChildren()) do
        if child.Name:find("Temp_") then
            pcall(function() child:Destroy() end)
        end
    end
end

local function makeCard(egg)
    local highlight = Instance.new("Highlight")
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 0.85
    highlight.OutlineTransparency = 0.2
    highlight.FillColor = egg.color
    highlight.OutlineColor = egg.color
    highlight.Parent = espFolder

    local billboard = Instance.new("BillboardGui")
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.Size = UDim2.fromOffset(150, 32)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.MaxDistance = 2500
    billboard.Parent = espFolder

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromScale(1, 1)
    frame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    frame.BackgroundTransparency = 0.25
    frame.BorderSizePixel = 0
    frame.Parent = billboard

    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 5)

    local frameStroke = Instance.new("UIStroke", frame)
    frameStroke.Color = egg.color
    frameStroke.Thickness = 1
    frameStroke.Transparency = 0.2
    frameStroke.Parent = frame

    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0, 2, 1, -6)
    accent.Position = UDim2.new(0, 3, 0, 3)
    accent.BackgroundColor3 = egg.color
    accent.BorderSizePixel = 0
    accent.Parent = frame

    Instance.new("UICorner", accent).CornerRadius = UDim.new(1, 0)

    local icon = Instance.new("ImageLabel")
    icon.Size = UDim2.fromOffset(24, 24)
    icon.Position = UDim2.new(0, 8, 0.5, -12)
    icon.BackgroundTransparency = 1
    icon.ScaleType = Enum.ScaleType.Fit
    icon.Image = egg.icon or ""
    icon.Visible = egg.icon ~= nil
    icon.Parent = frame

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -40, 0, 13)
    nameLabel.Position = UDim2.new(0, 36, 0, 4)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 11
    nameLabel.TextColor3 = egg.color
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
    nameLabel.Text = egg.name
    nameLabel.Parent = frame

    local info = Instance.new("TextLabel")
    info.Size = UDim2.new(1, -40, 0, 11)
    info.Position = UDim2.new(0, 36, 0, 17)
    info.BackgroundTransparency = 1
    info.Font = Enum.Font.Gotham
    info.TextSize = 9
    info.TextColor3 = Color3.fromRGB(200, 200, 210)
    info.TextXAlignment = Enum.TextXAlignment.Left
    info.TextTruncate = Enum.TextTruncate.AtEnd
    info.Text = ("%s/s | %s"):format(rateFormat(egg.value), egg.rarity)
    info.Parent = frame

    return {
        holder = billboard,
        highlight = highlight,
        frame = frame,
        name = nameLabel,
        info = info,
        icon = icon,
        stroke = frameStroke,
        accent = accent,
    }
end

task.spawn(function()
    while true do
        task.wait(0.35)

        if not Config.ESPEgg and not Config.ESPEggTerreno then
            if next(espCards) then clearESP() end
        else
            local list = listEggs()
            local present = {}
            local slots = workspace:FindFirstChild("AreaEggSlotsClient")
            local placedRenders = workspace:FindFirstChild("PlacedEggRenders")

            for _, egg in ipairs(list) do
                local permitido
                if egg.isBase then
                    permitido = Config.ESPEggTerreno
                else
                    permitido = Config.ESPEgg
                end

                if permitido then
                    present[egg.uid] = egg
                    local card = espCards[egg.uid]
                    if not card then
                        card = makeCard(egg)
                        espCards[egg.uid] = card
                    end

                    local hitbox

                    if egg.isBase and placedRenders then
                        local realUid = egg.uid:gsub("^base_", "")
                        for _, child in ipairs(placedRenders:GetChildren()) do
                            if string.find(child.Name, realUid, 1, true) then
                                if child:IsA("Model") then
                                    hitbox = child.PrimaryPart
                                    if not hitbox then
                                        for _, d in ipairs(child:GetDescendants()) do
                                            if d:IsA("BasePart") then
                                                hitbox = d
                                                break
                                            end
                                        end
                                    end
                                elseif child:IsA("BasePart") then
                                    hitbox = child
                                end
                                break
                            end
                        end
                    elseif slots then
                        local model = slots:FindFirstChild(egg.uid)
                        if not model then
                            for _, child in ipairs(slots:GetChildren()) do
                                if string.find(child.Name, egg.uid, 1, true) then
                                    model = child
                                    break
                                end
                            end
                        end
                        if model then
                            local hb = model:FindFirstChild("Hitbox")
                                or model:FindFirstChildWhichIsA("BasePart", true)
                            if hb and hb:IsA("BasePart") then
                                hitbox = hb
                            end
                        end
                    end

                    if not hitbox and egg.pos then
                        local tempName = "Temp_" .. egg.uid
                        local tempPart = espFolder:FindFirstChild(tempName)
                        if not tempPart then
                            tempPart = Instance.new("Part")
                            tempPart.Name = tempName
                            tempPart.Size = Vector3.new(1, 1, 1)
                            tempPart.Transparency = 1
                            tempPart.Anchored = true
                            tempPart.CanCollide = false
                            tempPart.CanTouch = false
                            tempPart.CanQuery = false
                            tempPart.Parent = espFolder
                        end
                        pcall(function() tempPart.Position = egg.pos end)
                        hitbox = tempPart
                    end

                    if hitbox then
                        card.holder.Adornee = hitbox
                        card.highlight.Adornee = hitbox
                        card.holder.StudsOffsetWorldSpace = Vector3.new(0, 2.5, 0)
                    end

                    if card.name.Text ~= egg.name then
                        card.name.Text = egg.name
                    end
                    card.name.TextColor3 = egg.color
                    card.stroke.Color = egg.color
                    card.accent.BackgroundColor3 = egg.color

                    local infoText = ("%s/s | %s"):format(rateFormat(egg.value), egg.rarity)
                    if card.info.Text ~= infoText then
                        card.info.Text = infoText
                    end

                    if egg.icon then
                        if card.icon.Image ~= egg.icon then
                            card.icon.Image = egg.icon
                        end
                        if not card.icon.Visible then
                            card.icon.Visible = true
                        end
                    else
                        if card.icon.Visible then
                            card.icon.Visible = false
                        end
                    end
                end
            end

            for uid, card in pairs(espCards) do
                if not present[uid] then
                    pcall(function() card.highlight:Destroy() end)
                    pcall(function() card.holder:Destroy() end)
                    espCards[uid] = nil
                    local temp = espFolder:FindFirstChild("Temp_" .. uid)
                    if temp then
                        pcall(function() temp:Destroy() end)
                    end
                end
            end
        end
    end
end)

