-- ============================================================
-- EXTRAS: Anti-Trap + Instant Click
-- Tudo ligado direto, sem GUI, sem print
-- ============================================================
local CollectionService = game:GetService("CollectionService")

-- ============ ANTI-TRAP ============
local canTouchOriginais = {}

local function desativarTouch(inst)
    if inst:IsA("BasePart") and canTouchOriginais[inst] == nil then
        canTouchOriginais[inst] = inst.CanTouch
        pcall(function()
            inst.CanTouch = false
        end)
    end
end

local function processarTrap(trap)
    if not trap then return end
    desativarTouch(trap)
    for _, d in ipairs(trap:GetDescendants()) do
        desativarTouch(d)
    end
end

for _, t in ipairs(CollectionService:GetTagged("PlacedTrap")) do
    processarTrap(t)
end

CollectionService:GetInstanceAddedSignal("PlacedTrap"):Connect(function(t)
    task.defer(function()
        processarTrap(t)
    end)
end)

workspace.DescendantAdded:Connect(function(d)
    local pai = d.Parent
    while pai do
        if pai:HasTag("PlacedTrap") then
            desativarTouch(d)
            break
        end
        pai = pai.Parent
    end
end)

-- ============ INSTANT CLICK (Instant Prompt) ============
local function aplicarInstantClick(obj)
    if obj:IsA("ProximityPrompt") then
        pcall(function()
            obj.HoldDuration = 0
            obj.RequiresLineOfSight = false
        end)
    end
end

for _, v in ipairs(workspace:GetDescendants()) do
    aplicarInstantClick(v)
end

workspace.DescendantAdded:Connect(function(v)
    aplicarInstantClick(v)
end)
