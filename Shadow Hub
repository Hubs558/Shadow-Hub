local function FilterList(list)
    local q = EggPanel.SearchQuery
    if not q or q == "" then return list end
    local synonyms = GetSynonyms(q)
    local out = {}
    for _, egg in ipairs(list) do
        local nameNorm = NormalizeText(egg.name)
        local rarityNorm = NormalizeText(egg.rarity)
        local catNorm = NormalizeText(egg.cat)
        local matched = false
        for _, syn in ipairs(synonyms) do
            if syn ~= "" then
                if nameNorm:find(syn, 1, true)
                   or rarityNorm:find(syn, 1, true)
                   or catNorm:find(syn, 1, true) then
                    matched = true
                    break
                end
            end
        end
        if matched then out[#out + 1] = egg end
    end
    return out
end

