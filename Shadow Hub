local function calcValue(rec)
    if not AssetsEarnings then return 0 end
    local baseRate = 0
    local d = AssetsDir and AssetsDir[rec.AssetCategory]
    if d then
        if d.Egg and tonumber(d.Egg.Earnings) then
            baseRate = tonumber(d.Egg.Earnings)
        elseif tonumber(d.Earnings) then
            baseRate = tonumber(d.Earnings)
        elseif tonumber(d.BaseRate) then
            baseRate = tonumber(d.BaseRate)
        end
    end
    if baseRate == 0 then
        local item = { Category = rec.AssetCategory, Scale = tonumber(rec.AssetScale) or 1, Mutations = rec.Mutations or {} }
        local ok, v = pcall(AssetsEarnings.LiveRatePerSecond, item, nil, nil, LocalPlayer)
        if ok and type(v) == "number" and v > 0 then return v end
    end
    local scale = tonumber(rec.AssetScale) or 1
    local total = baseRate * scale
    local muts = rec.Mutations or {}
    local mutMult = 1
    for _, m in pairs(muts) do
        if type(m) == "table" and tonumber(m.Multiplier) then
            mutMult = mutMult * tonumber(m.Multiplier)
        elseif type(m) == "string" then
            local mutData = AssetsDir and AssetsDir[m]
            if mutData and tonumber(mutData.Multiplier) then
                mutMult = mutMult * tonumber(mutData.Multiplier)
            end
        end
    end
    return total * mutMult
end

local function displayName(cat)
    local d = AssetsDir and AssetsDir[cat]
    return (d and d.DisplayName) or cat or "?"
end

local function rarityOf(cat)
    local d = AssetsDir and AssetsDir[cat]
    if d and d.Rarity then return d.Rarity.DisplayName or d.Rarity._id or "?" end
    return "?"
end

local function rarityColorOf(cat)
    local d = AssetsDir and AssetsDir[cat]
    if d and d.Rarity and typeof(d.Rarity.Color) == "Color3" then return d.Rarity.Color end
    return Color3.fromRGB(200, 200, 200)
end

local function iconOf(cat)
    local d = AssetsDir and AssetsDir[cat]
    if type(d) ~= "table" then return nil end
    if d.Icon and d.Icon ~= "" then
        local s = tostring(d.Icon)
        if tonumber(s) then return "rbxassetid://" .. s end
        if s:find("rbxassetid") then return s end
    end
    if type(d.Egg) == "table" and d.Egg.Icon and d.Egg.Icon ~= "" then
        local s = tostring(d.Egg.Icon)
        if tonumber(s) then return "rbxassetid://" .. s end
        if s:find("rbxassetid") then return s end
    end
    return nil
end

local function weightOf(rec)
    local d = AssetsDir and AssetsDir[rec.AssetCategory]
    local base = d and d.Egg and tonumber(d.Egg.WeightKg)
    if not base then return 0 end
    return base * (tonumber(rec.AssetScale) or 1)
end

local function rateFormat(n)
    n = tonumber(n) or 0
    for _, u in ipairs({ { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }) do
        if n >= u[1] then
            local v = n / u[1]
            local txt = (v < 10) and string.format("%.2f", v) or string.format("%.1f", v)
            return (txt:gsub("%.?0+$", "")) .. u[2]
        end
    end
    return tostring(math.floor(n))
end

local function NormalizeText(s)
    s = string.lower(tostring(s or ""))
    s = s:gsub("á","a"):gsub("à","a"):gsub("ã","a"):gsub("â","a"):gsub("ä","a")
    s = s:gsub("é","e"):gsub("è","e"):gsub("ê","e"):gsub("ë","e")
    s = s:gsub("í","i"):gsub("ì","i"):gsub("î","i"):gsub("ï","i")
    s = s:gsub("ó","o"):gsub("ò","o"):gsub("õ","o"):gsub("ô","o"):gsub("ö","o")
    s = s:gsub("ú","u"):gsub("ù","u"):gsub("û","u"):gsub("ü","u")
    s = s:gsub("ç","c"):gsub("ñ","n")
    return s
end

