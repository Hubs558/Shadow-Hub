-- SET STEAL
-- ============================================================

local function setSteal(ativo)
    Roubo.Enabled = ativo
    animarToggle(ativo)

    if not ativo then
        Roubo.Running = false
        return
    end

    if not Roubo.SelectedUid then
        local lista = listCampoEggs()
        if #lista > 0 then
            Roubo.SelectedUid = lista[1].uid
            Roubo.SelectedCat = lista[1].cat
            Roubo.LockedUid = lista[1].uid
            Roubo.LockedCat = lista[1].cat
        else
            Roubo.Enabled = false
            animarToggle(false)
            return
        end
    end

    task.spawn(function()
        while Roubo.Enabled do
            local version = Roubo.TargetVersion
            rodarCicloMultiArea()

            if not Roubo.Enabled then break end

            if Roubo.TargetVersion ~= version then
                task.wait(0.03)
            else
                Roubo.Enabled = false
                Roubo.Running = false
                animarToggle(false)
                break
            end
        end
    end)
end

toggle.MouseButton1Click:Connect(function()
    playClick()
    setSteal(not Roubo.Enabled)
end)

