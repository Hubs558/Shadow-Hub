local EggModels = {}

local function FindEggModel(category)
    if EggModels[category] ~= nil then
        return EggModels[category] or nil
    end
    local model = nil
    pcall(function()
        local am = ReplicatedStorage:FindFirstChild("AssetModels")
        if am then model = am:FindFirstChild(category) end
        if not model then
            local assets = ReplicatedStorage:FindFirstChild("Assets")
            local models = assets and assets:FindFirstChild("Models")
            local eggs   = models and models:FindFirstChild("Eggs")
            if eggs then model = eggs:FindFirstChild(category) end
        end
        if not model then
            local am = ReplicatedStorage:FindFirstChild("AssetModels")
            if am then
                model = am:FindFirstChild(category .. "Egg")
                    or am:FindFirstChild(category .. "_Egg")
                    or am:FindFirstChild(category .. " Egg")
            end
        end
    end)
    EggModels[category] = model or false
    return EggModels[category] or nil
end

local ActiveViewports = {}

RunService.RenderStepped:Connect(function(dt)
    for holder, data in pairs(ActiveViewports) do
        if not holder.Parent then
            ActiveViewports[holder] = nil
        else
            data.angle = (data.angle + dt * 0.9) % (math.pi * 2)
            local rot = CFrame.new(data.center)
                * CFrame.Angles(0, data.angle, 0)
                * CFrame.new(-data.center)
            pcall(function()
                if data.model:IsA("Model") then
                    data.model:PivotTo(rot * data.basePivot)
                else
                    data.model.CFrame = rot * data.basePivot
                end
            end)
        end
    end
end)

local function CreateEggIcon(category, size)
    local holder = Instance.new("Frame")
    holder.Name = "IconFrame"
    holder.Size = UDim2.fromOffset(size, size)
    holder.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
    holder.BorderSizePixel = 0
    holder.ClipsDescendants = true
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = holder

    local original = FindEggModel(category)
    if original then
        local vf = Instance.new("ViewportFrame")
        vf.Size = UDim2.fromScale(1, 1)
        vf.BackgroundTransparency = 1
        vf.Ambient = Color3.fromRGB(180, 180, 180)
        vf.LightColor = Color3.fromRGB(255, 255, 255)
        vf.LightDirection = Vector3.new(-0.4, -1, -0.6)
        vf.Parent = holder

        local cam = Instance.new("Camera")
        cam.FieldOfView = 55
        cam.Parent = vf
        vf.CurrentCamera = cam

        local ok, clone = pcall(function() return original:Clone() end)
        if ok and clone then
            for _, d in ipairs(clone:GetDescendants()) do
                if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
                    d:Destroy()
                elseif d:IsA("BasePart") then
                    d.Anchored = true
                    d.CanCollide = false
                end
            end
            clone.Parent = vf

            local bbox, size3d
            if clone:IsA("Model") then
                if not clone.PrimaryPart then
                    clone.PrimaryPart = clone:FindFirstChildWhichIsA("BasePart", true)
                end
                local ok2, b, s = pcall(function() return clone:GetBoundingBox() end)
                if ok2 then bbox, size3d = b, s end
            elseif clone:IsA("BasePart") then
                bbox = clone.CFrame
                size3d = clone.Size
            end

            if bbox and size3d then
                local center = bbox.Position
                local radius = math.max(size3d.Magnitude / 2, 1)
                local camDist = radius / math.tan(math.rad(cam.FieldOfView / 2)) * 1.4
                cam.CFrame = CFrame.lookAt(
                    center + Vector3.new(0, radius * 0.25, camDist),
                    center
                )
                local basePivot = clone:IsA("Model") and clone:GetPivot() or clone.CFrame
                ActiveViewports[holder] = {
                    model = clone, center = center,
                    basePivot = basePivot, angle = 0,
                }
            end
        end
    else
        local dir = AssetsDir and AssetsDir[category]
        if dir and dir.Icon then
            local icon = Instance.new("ImageLabel")
            icon.BackgroundTransparency = 1
            icon.Size = UDim2.fromScale(0.75, 0.75)
            icon.Position = UDim2.fromScale(0.125, 0.125)
            icon.ScaleType = Enum.ScaleType.Fit
            icon.Image = dir.Icon
            icon.Parent = holder
            local c2 = Instance.new("UICorner")
            c2.CornerRadius = UDim.new(1, 0)
            c2.Parent = icon
        end
    end
    return holder
end

