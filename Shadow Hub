local function GetSynonyms(query)
    local q = NormalizeText(query)
    local out = { q }
    if PT_EN[q] then out[#out + 1] = NormalizeText(PT_EN[q]) end
    for pt, en in pairs(PT_EN) do
        if NormalizeText(pt):find(q, 1, true) then
            out[#out + 1] = NormalizeText(en)
        end
    end
    return out
end

