        if Roubo.SelectedUid and not selecionadoExiste then
            Roubo.SelectedUid = nil
            Roubo.SelectedCat = nil
            Roubo.LockedUid = nil
            Roubo.LockedCat = nil
            eggName.Text = "Nenhum ovo selecionado"
            eggInfo.Text = "Selecione um ovo"
            eggIcon.Image = ""
        end

        if #ovos > 0 and not Roubo.SelectedUid and not Roubo.LockedUid then
            selecionarOvoAuto(ovos[1])
        end
    end
end)

