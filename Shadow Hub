local function trocarHumanoid(character)
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    if humanoid:GetAttribute("_trocado") then return end

    local camera = workspace.CurrentCamera
    local animateScript = character:FindFirstChild("Animate")

    local walkSpeed = humanoid.WalkSpeed
    local jumpPower = humanoid.JumpPower
    local jumpHeight = humanoid.JumpHeight
    local health = humanoid.Health
    local maxHealth = humanoid.MaxHealth

    humanoid:SetAttribute("_trocado", true)

    if animateScript and animateScript:IsA("LocalScript") then
        animateScript.Disabled = true
    end

    humanoid.Archivable = true
    local newHumanoid = humanoid:Clone()

    for _, child in next, newHumanoid:GetChildren() do
        if child:IsA("Animator") then child:Destroy() end
    end

    humanoid.Name = "_OldHumanoid"
    newHumanoid.Name = "Humanoid"
    newHumanoid.Parent = character

    local animator = Instance.new("Animator")
    animator.Parent = newHumanoid

    newHumanoid.WalkSpeed = walkSpeed
    newHumanoid.JumpPower = jumpPower
    newHumanoid.JumpHeight = jumpHeight
    newHumanoid.MaxHealth = maxHealth
    newHumanoid.Health = math.min(health, maxHealth)

    pcall(function()
        newHumanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        newHumanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
        newHumanoid:SetStateEnabled(Enum.HumanoidStateType.Landed, true)
        newHumanoid:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        newHumanoid:SetStateEnabled(Enum.HumanoidStateType.RunningNoPhysics, true)
        newHumanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
        newHumanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
        newHumanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, true)

        newHumanoid.UseJumpPower = true
        if newHumanoid.JumpPower < 50 then newHumanoid.JumpPower = 50 end
    end)

    if camera then camera.CameraSubject = newHumanoid end
    humanoid:Destroy()

    pcall(function()
        local playerScripts = localPlayer:FindFirstChild("PlayerScripts")
        local playerModule = playerScripts and playerScripts:FindFirstChild("PlayerModule")
        if playerModule then
            local controls = require(playerModule):GetControls()
            if type(controls) == "table" then controls.humanoid = newHumanoid end
            if type(controls.OnCharacterAdded) == "function" then
                pcall(controls.OnCharacterAdded, controls, character)
            end
        end
    end)

    if animateScript and animateScript:IsA("LocalScript") then
        task.wait()
        animateScript.Disabled = false
    end

    task.defer(function()
        if newHumanoid.Parent then
            newHumanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
    end)
end

