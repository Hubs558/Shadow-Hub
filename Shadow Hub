-- LISTA DE OVOS (COM OVOS DO TERRENO)
-- ============================================================

local stolen = {}
local unreachable = {}

local STOLEN_FOR = 120
local UNREACHABLE_FOR = 45

local function pruneStolen()
    local now = os.clock()

    for uid, at in pairs(stolen) do
        if now - at > STOLEN_FOR then
            stolen[uid] = nil
        end
    end

    for uid, at in pairs(unreachable) do
        if now - at > UNREACHABLE_FOR then
            unreachable[uid] = nil
        end
    end
end

local function ovoExisteNoMundo(pos)
    if not pos then return false end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local p = obj.Parent
            if p then
                local ppos
                if p:IsA("BasePart") then
                    ppos = p.Position
                elseif p:IsA("Model") then
                    ppos = p:GetPivot().Position
                end

                if ppos and (ppos - pos).Magnitude < 12 then
                    return true
                end
            end
        end
    end

    return false
end

local function listEggs(confirmarMundo)
    if not EggState
        or type(EggState.ReadFieldEggs) ~= "function" then
        return {}
    end

    local ok, data = pcall(EggState.ReadFieldEggs)
    if not ok or type(data) ~= "table" or type(data.Records) ~= "table" then
        return {}
    end

    pruneStolen()

    local placedRenders = workspace:FindFirstChild("PlacedEggRenders")
    local out = {}
    local vistos = {}

    -- ========================================================
    -- OVOS DO CAMPO
    -- ========================================================
    for _, rec in pairs(data.Records) do
        if type(rec) == "table" and rec.Uid and rec.AssetCategory then
            local uid = tostring(rec.Uid)

            if not vistos[uid] then
                local pos
                if rec.BoundsCFrame and rec.BoundsCFrame.Position then
                    pos = rec.BoundsCFrame.Position
                elseif rec.CFrame and rec.CFrame.Position then
                    pos = rec.CFrame.Position
                elseif rec.Position then
                    pos = rec.Position
                end

                local state = tostring(rec.State or "?")
                local carregado = rec.CarrierUserId ~= nil and rec.CarrierUserId ~= 0

                local valido = state ~= "Carried"
                    and state ~= "Inventory"
                    and state ~= "Base"
                    and not carregado
                    and pos ~= nil

                if valido then
                    if rec.Active == false
                        or rec.IsActive == false
                        or rec.Removed == true
                        or rec.IsRemoved == true
                        or rec.Dead == true
                        or rec.IsDead == true
                        or rec.Despawned == true
                        or rec.IsDespawned == true then
                        valido = false
                    end
                end

                if valido and stolen[uid] then
                    valido = false
                end

                if valido and unreachable[uid] then
                    valido = false
                end

                if valido then
                    vistos[uid] = true
                    out[#out + 1] = {
                        uid = uid,
                        state = state,
                        pos = pos,
                        value = calcValue(rec),
                        cat = rec.AssetCategory,
                        name = displayName(rec.AssetCategory),
                        rarity = rarityOf(rec.AssetCategory),
                        color = rarityColorOf(rec.AssetCategory),
                        icon = iconOf(rec.AssetCategory),
                        isBase = false,
                    }
                end
            end
        end
    end

    -- ========================================================
    -- OVOS DO TERRENO (BASE)
    -- ========================================================
    if type(EggState.ReadOwnerEggs) == "function" and placedRenders then
        local okOwner, ownerEggs = pcall(EggState.ReadOwnerEggs, localPlayer.UserId)

        if okOwner and type(ownerEggs) == "table" then
            for uid, rec in pairs(ownerEggs) do
                if type(rec) == "table"
                    and rec.Placement ~= nil
                    and rec.AssetCategory then

                    local model
                    for _, child in ipairs(placedRenders:GetChildren()) do
                        if string.find(child.Name, tostring(uid), 1, true) then
                            model = child
                            break
                        end
                    end

                    if model then
                        local pos
                        pcall(function()
                            if model:IsA("Model") then
                                pos = model:GetPivot().Position
                            elseif model:IsA("BasePart") then
                                pos = model.CFrame.Position
                            end
                        end)

                        if pos then
                            out[#out + 1] = {
                                uid = "base_" .. tostring(uid),
                                state = "Base",
                                pos = pos,
                                value = calcValue(rec),
                                cat = rec.AssetCategory,
                                name = displayName(rec.AssetCategory),
                                rarity = rarityOf(rec.AssetCategory),
                                color = rarityColorOf(rec.AssetCategory),
                                icon = iconOf(rec.AssetCategory),
                                isBase = true,
                            }
                        end
                    end
                end
            end
        end
    end

    table.sort(out, function(a, b) return a.value > b.value end)
    return out
end

local function listCampoEggs()
    local out = {}
    for _, egg in ipairs(listEggs()) do
        if not egg.isBase then
            out[#out + 1] = egg
        end
    end
    return out
end

local function acharOvoPorUid(uid)
    if not uid then
        return nil
    end

    for _, egg in ipairs(listEggs()) do
        if egg.uid == uid then
            return egg
        end
    end

    return nil
end

local function acharOvoMesmoTipoPerto(cat, posJogador, raio)
    raio = raio or 30

    local maisPerto
    local menorDist = raio

    for _, egg in ipairs(listEggs()) do
        if egg.cat == cat and egg.pos and not egg.isBase then
            local dist = (egg.pos - posJogador).Magnitude
            if dist < menorDist then
                menorDist = dist
                maisPerto = egg
            end
        end
    end

    return maisPerto
end

