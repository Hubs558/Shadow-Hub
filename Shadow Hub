local function estaSegurandoOvoAPI()
    if not EggState
        or type(EggState.ReadFieldEggs) ~= "function" then
        return false
    end

    local ok, data = pcall(EggState.ReadFieldEggs)
    if not ok or type(data) ~= "table" or type(data.Records) ~= "table" then
        return false
    end

    for _, rec in pairs(data.Records) do
        if type(rec) == "table"
            and rec.State == "Carried"
            and tonumber(rec.CarrierUserId) == localPlayer.UserId then
            return true, tostring(rec.Uid)
        end
    end

    return false
end

local function estaSegurandoOvo()
    local api, uid = estaSegurandoOvoAPI()
    if api then return true, uid end

    if Carregando.IsCarrying and Carregando.Uid then
        return true, Carregando.Uid
    end

    return false
end

