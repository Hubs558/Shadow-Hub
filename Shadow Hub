-- ============================================================
-- PEGAR OVO VIA PROMPT
-- ============================================================

local function pegarOvoViaPrompt(targetPos)
    local best
    local bestDist = math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local p = obj.Parent
            if p then
                local pos
                if p:IsA("BasePart") then
                    pos = p.Position
                elseif p:IsA("Model") then
                    pos = p:GetPivot().Position
                end

                if pos then
                    local dist = (pos - targetPos).Magnitude
                    if dist < bestDist and dist < 40 then
                        best = obj
                        bestDist = dist
                    end
                end
            end
        end
    end

    if not best then return false end

    pcall(function()
        best.HoldDuration = 0
        best.RequiresLineOfSight = false
    end)

    if typeof(fireproximityprompt) == "function" then
        pcall(fireproximityprompt, best)
        return true
    end

    return false
end

