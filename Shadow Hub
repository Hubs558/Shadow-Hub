local function setSteal(ativo)
    Roubo.Enabled = ativo
    animarStealToggle(ativo)

    if ativo then
        -- ✅ Se tem ovo travado, usa ele. Senão, pega o primeiro da lista
        if Roubo.LockedUid then
            Roubo.SelectedUid = Roubo.LockedUid
            Roubo.SelectedCat = Roubo.LockedCat
        else
            local lista = listEggs(false)
            if #lista > 0 then
                Roubo.SelectedUid = lista[1].uid
                Roubo.SelectedCat = lista[1].cat
            else
                Roubo.Enabled = false
                Roubo.Running = false
                animarStealToggle(false)
                return
            end
        end

        -- ✅ Confirma que o uid existe na lista atual
        local existe = false
        for _, e in ipairs(listEggs(false)) do
            if e.uid == Roubo.SelectedUid then
                existe = true
                Roubo.SelectedCat = e.cat
                break
            end
        end

        if not existe then
            -- Se o ovo travado não existe mais, destrava
            Roubo.LockedUid = nil
            Roubo.LockedCat = nil

            local lista = listEggs(false)
            if #lista > 0 then
                Roubo.SelectedUid = lista[1].uid
                Roubo.SelectedCat = lista[1].cat
            else
                Roubo.Enabled = false
                Roubo.Running = false
                animarStealToggle(false)
                return
            end
        end

        task.spawn(function()
            rodarCicloMultiArea()
            if Roubo.Enabled then
                Roubo.Enabled = false
                Roubo.Running = false
                animarStealToggle(false)
            end
        end)
    else
        Roubo.Running = false
    end
end

