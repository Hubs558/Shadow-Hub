-- ============================================================

local function pegarQualquerDoTipo(cat, cancelFn, tempo)
    tempo = tempo or 4
    local inicio = os.clock()

    while os.clock() - inicio < tempo do
        if cancelFn() then return false end

        if estaSegurandoOvo() then
            return true
        end

        local hrp = getRoot()
        if hrp then
            local perto = acharOvoMesmoTipoPerto(cat, hrp.Position, 60)
            if perto and perto.pos then
                local hum = getHum()
                if hum then
                    local dist = (
                        Vector3.new(
                            perto.pos.X,
                            hrp.Position.Y,
                            perto.pos.Z
                        ) - hrp.Position
                    ).Magnitude

                    if dist > 5 then
                        hum:MoveTo(perto.pos)
                    else
                        travarPersonagem()
                        pegarOvoViaPrompt(perto.pos)
                        pegarOvoViaPrompt(perto.pos)
                        pegarOvoViaPrompt(perto.pos)
                    end
                end
            end
        end

        RunService.Heartbeat:Wait()
    end

    return estaSegurandoOvo()
end

-- ============================================================
-- ROUBA OVO
-- ============================================================

local function pegarOvoSemParar(target, cancelFn)
    local tentativasSemOvo = 0

    while not cancelFn() do
        if estaSegurandoOvo() then
            return true
        end

        local ovo = acharOvoPorUid(target.uid)

        if not ovo or not ovo.pos then
            local hrp = getRoot()
            if hrp then
                local perto = acharOvoMesmoTipoPerto(
                    target.cat,
                    hrp.Position,
                    50
                )
                if perto then
                    target.uid = perto.uid
                    target.pos = perto.pos
                    ovo = perto
                end
            end
        end

        if not ovo or not ovo.pos then
            tentativasSemOvo = tentativasSemOvo + 1
            if tentativasSemOvo > 100 then
                return false
            end
            task.wait(0.02)
        else
            tentativasSemOvo = 0
            target.pos = ovo.pos

            local hum = getHum()
            local hrp = getRoot()

            if hum and hrp then
                local horizontal = Vector3.new(
                    ovo.pos.X,
                    hrp.Position.Y,
                    ovo.pos.Z
                )

                local dist = (horizontal - hrp.Position).Magnitude

                if dist > 5 then
                    hum:MoveTo(ovo.pos)
                else
                    while not cancelFn() and not estaSegurandoOvo() do
                        travarPersonagem()
                        pegarOvoViaPrompt(ovo.pos)
                        pegarOvoViaPrompt(ovo.pos)
                        pegarOvoViaPrompt(ovo.pos)
                        RunService.Heartbeat:Wait()
                    end

                    if estaSegurandoOvo() then
                        subirProCeu()
                        return true
                    end
                end
            end
        end

        RunService.Heartbeat:Wait()
    end

    return false
end

