-- ============================================================
-- DETECTAR ÁREA ATUAL
-- ============================================================

local function getRoot()
    local char = localPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local char = localPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function detectarAreaAtual()
    local hrp = getRoot()
    if not hrp then
        return nil, nil
    end

    local melhorIndex = nil
    local menorDist = math.huge

    for i, area in ipairs(AREAS) do
        if i > SAFE_INDEX then
            local dist = (
                Vector3.new(
                    hrp.Position.X,
                    area.pos.Y,
                    hrp.Position.Z
                ) - Vector3.new(
                    area.pos.X,
                    area.pos.Y,
                    area.pos.Z
                )
            ).Magnitude

            if dist < menorDist then
                menorDist = dist
                melhorIndex = i
            end
        end
    end

    if melhorIndex then
        return melhorIndex, AREAS[melhorIndex]
    end

    return nil, nil
end

-- ============================================================
-- PRÓXIMO DESTINO
-- Leão (14) e Demon Anjo (13) → vizinha (índice - 1)
-- Resto → pula 1 (índice - 2)
-- ============================================================

local function proximoDestino(indexAtual)
    if not indexAtual then
        return SAFE_INDEX, AREAS[SAFE_INDEX]
    end

    local proximoIndex

    if indexAtual == 14 or indexAtual == 13 then
        proximoIndex = indexAtual - 1
    else
        proximoIndex = indexAtual - 2
    end

    if proximoIndex <= SAFE_INDEX then
        return SAFE_INDEX, AREAS[SAFE_INDEX]
    end

    return proximoIndex, AREAS[proximoIndex]
end

