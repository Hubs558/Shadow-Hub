local panelOpen = true
local openPosition = panel.Position
local openScale = panelScale.Scale

local panelTween = TweenInfo.new(
    0.22,
    Enum.EasingStyle.Quart,
    Enum.EasingDirection.Out
)

local function setPanelOpen(open)
    if panelOpen == open then return end
    panelOpen = open
    playClick()

    if open then
        panel.Visible = true
        panel.BackgroundTransparency = 1
        panelScale.Scale = openScale * 0.88

        TweenService:Create(
            panel,
            panelTween,
            { BackgroundTransparency = 0.08 }
        ):Play()

        TweenService:Create(
            panelScale,
            panelTween,
            { Scale = openScale }
        ):Play()
    else
        local closeTween = TweenService:Create(
            panel,
            panelTween,
            { BackgroundTransparency = 1 }
        )

        TweenService:Create(
            panelScale,
            panelTween,
            { Scale = openScale * 0.88 }
        ):Play()

        closeTween:Play()

        closeTween.Completed:Connect(function()
            if not panelOpen then
                panel.Visible = false
            end
        end)
    end
end

icon.MouseButton1Click:Connect(function()
    setPanelOpen(not panelOpen)
end)

