local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHum()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function pegarOvoViaPrompt(targetPos)
    local best, bestDist = nil, math.huge
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled then
            local parent = d.Parent
            if parent and (parent:IsA("BasePart") or parent:IsA("Model")) then
                local ppos = parent:IsA("BasePart") and parent.Position
                    or (parent:IsA("Model") and parent:GetPivot().Position)
                if ppos then
                    local dist = (ppos - targetPos).Magnitude
                    if dist < bestDist and dist < 40 then
                        best, bestDist = d, dist
                    end
                end
            end
        end
    end
    if not best then return false end
    if typeof(fireproximityprompt) == "function" then
        pcall(function()
            if best.HoldDuration and best.HoldDuration > 0 then
                best.HoldDuration = 0
            end
        end)
        pcall(fireproximityprompt, best)
        return true
    end
    return false
end

local function droparOvo()
    local networking = ReplicatedStorage:FindFirstChild("Packages")
    networking = networking and networking:FindFirstChild("Networking")
    local remote = networking and networking:FindFirstChild("RF/EggWorld/AskFieldEggDrop")
    if remote and remote:IsA("RemoteFunction") then
        pcall(function()
            remote:InvokeServer({ Reason = "PlayerRequest" })
        end)
        return true
    end
    return false
end

local function acharEsteiraPosicao()
    local plots = workspace:FindFirstChild("Plots")
    if plots then
        local mySlot = nil
        local remotes = nil
        local shared = ReplicatedStorage:FindFirstChild("Shared")
        if shared then
            local remoteMod = shared:FindFirstChild("Remotes")
            if remoteMod and remoteMod:IsA("ModuleScript") then
                local ok, r = pcall(require, remoteMod)
                if ok then remotes = r end
            end
        end
        if remotes and remotes.Homestead and remotes.Homestead.AskState then
            local ok, state = pcall(function() return remotes.Homestead.AskState:InvokeServer() end)
            if ok and type(state) == "table" and type(state.OwnersBySlot) == "table" then
                for slot, userId in pairs(state.OwnersBySlot) do
                    if tostring(userId) == tostring(LocalPlayer.UserId) then
                        mySlot = tostring(slot)
                        break
                    end
                end
            end
        end
        if mySlot then
            local plot = plots:FindFirstChild(mySlot)
            if plot then
                local tb = plot:FindFirstChild("TreadmillBottom")
                if tb and tb:IsA("BasePart") then return tb.Position end
                local tu = plot:FindFirstChild("TreadmillUpgrade")
                if tu then
                    local part = tu:IsA("BasePart") and tu or tu:FindFirstChildWhichIsA("BasePart", true)
                    if part then return part.Position end
                end
            end
        end
    end
    return nil
end

local function sairDaEsteira(treadmillPos)
    local networking = ReplicatedStorage:FindFirstChild("Packages")
    networking = networking and networking:FindFirstChild("Networking")
    if networking then
        local askDoff = networking:FindFirstChild("RF/Treadmill/AskDoff")
        if askDoff and askDoff:IsA("RemoteFunction") then
            pcall(function() askDoff:InvokeServer() end)
        end
    end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum.PlatformStand = false
                hum.Sit = false
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end)
            pcall(function() hum.Jump = true end)
        end
    end
    task.wait(0.1)
    local hrp = getRoot()
    if hrp and treadmillPos then
        if (hrp.Position - treadmillPos).Magnitude < 6 then
            local longe = Vector3.new(treadmillPos.X + 15, treadmillPos.Y + 3, treadmillPos.Z)
            local c = LocalPlayer.Character
            if c then pcall(function() c:PivotTo(CFrame.new(longe)) end) end
        end
    end
end

local function esperarRecuperarDeRagdoll(timeout, cancelFn)
    timeout = timeout or 10
    local t0 = os.clock()
    if not estaRagdolled() then return true end
    while os.clock() - t0 < timeout do
        if cancelFn and cancelFn() then return false end
        if not estaRagdolled() then
            task.wait(0.15)
            local hum = getHum()
            if hum then
                pcall(function()
                    hum.PlatformStand = false
                    hum.Sit = false
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end)
            end
            return true
        end
        local hum = getHum()
        if hum then
            pcall(function() if hum.PlatformStand then hum.PlatformStand = false end end)
        end
        RunService.Heartbeat:Wait()
    end
    return not estaRagdolled()
end

local function travarPersonagem()
    local hum = getHum()
    if not hum then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    pcall(function()
        hum:Move(Vector3.zero, false)
        hum:MoveTo(hrp.Position)
        hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function teleportarNormal(destino, cancelFn)
    local c = LocalPlayer.Character
    if not c then return false end
    local hrp = getRoot()
    if not hrp then return false end
    local posAtual = hrp.Position

    pcall(function() c:PivotTo(CFrame.new(Vector3.new(posAtual.X, 250, posAtual.Z))) end)
    task.wait(0.15)
    pcall(function() c:PivotTo(CFrame.new(Vector3.new(destino.X, 250, destino.Z))) end)
    task.wait(0.15)

    local t0 = os.clock()
    while os.clock() - t0 < 0.3 do
        if cancelFn and cancelFn() then return false end
        local f = (os.clock() - t0) / 0.3
        local y = 250 + (destino.Y - 250) * f
        local cc = LocalPlayer.Character
        if cc then
            pcall(function()
                cc:PivotTo(CFrame.new(Vector3.new(destino.X, y, destino.Z)))
            end)
        end
        RunService.Heartbeat:Wait()
    end
    return true
end

local function pegarOvoSemParar(target, cancelFn)
    while not cancelFn() do
        local ovo = acharOvoPorUid(target.uid)
        if not ovo or not ovo.pos then
            local hrpAgora = getRoot()
            if hrpAgora then
                local maisPerto = acharOvoMesmoTipoPerto(target.cat, hrpAgora.Position, 30)
                if maisPerto then
                    target.uid = maisPerto.uid
                    target.pos = maisPerto.pos
                    ovo = maisPerto
                end
            end
            if not ovo or not ovo.pos then
                local tEspera = os.clock()
                while os.clock() - tEspera < 2.0 do
                    if cancelFn() then return false end
                    task.wait(0.15)
                    ovo = acharOvoPorUid(target.uid)
                    if ovo and ovo.pos then break end
                    local hrp2 = getRoot()
                    if hrp2 then
                        local perto2 = acharOvoMesmoTipoPerto(target.cat, hrp2.Position, 30)
                        if perto2 then
                            target.uid = perto2.uid
                            target.pos = perto2.pos
                            ovo = perto2
                            break
                        end
                    end
                end
                if not ovo or not ovo.pos then return false end
            end
        end

        target.pos = ovo.pos
        local hum = getHum()
        local hrp = getRoot()
        if hum and hrp then
            local dist = (Vector3.new(ovo.pos.X, hrp.Position.Y, ovo.pos.Z)
                         - Vector3.new(hrp.Position.X, hrp.Position.Y, hrp.Position.Z)).Magnitude
            if dist > 6 then
                hum:MoveTo(ovo.pos)
            else
                travarPersonagem()
                pegarOvoViaPrompt(ovo.pos)
                task.wait(0.02)
                pegarOvoViaPrompt(ovo.pos)
                task.wait(0.02)
                pegarOvoViaPrompt(ovo.pos)
            end
        end

        if estaSegurandoOvo() then
            local cAgora = LocalPlayer.Character
            if cAgora then
                local hrpAgora = cAgora:FindFirstChild("HumanoidRootPart")
                if hrpAgora then
                    local posAgora = hrpAgora.Position
                    pcall(function()
                        cAgora:PivotTo(CFrame.new(Vector3.new(posAgora.X, 250, posAgora.Z)))
                    end)
                end
            end
            task.wait(0.15)
            if estaSegurandoOvo() then return true end
        end

        if estaRagdolled() then
            esperarRecuperarDeRagdoll(8, cancelFn)
        end

        RunService.Heartbeat:Wait()
    end
    return false
end

local function pegarUidEspecifico(uidAlvo, target, cancelFn, timeout)
    timeout = timeout or 15
    local t0 = os.clock()
    while os.clock() - t0 < timeout do
        if cancelFn() then return false end
        if estaSegurandoOvo() then
            task.wait(0.3)
            if estaSegurandoOvo() then return true end
        end
        if estaRagdolled() then esperarRecuperarDeRagdoll(8, cancelFn) end

        local ovo = acharOvoPorUid(uidAlvo)
        if not ovo or not ovo.pos then
            local hrpAgora = getRoot()
            if hrpAgora and target and target.cat then
                local perto = acharOvoMesmoTipoPerto(target.cat, hrpAgora.Position, 30)
                if perto then
                    ovo = perto
                    uidAlvo = perto.uid
                end
            end
        end

        if ovo and ovo.pos then
            local hum = getHum()
            local hrp = getRoot()
            if hum and hrp then
                local pos = ovo.pos
                local dist = (Vector3.new(pos.X, hrp.Position.Y, pos.Z)
                             - Vector3.new(hrp.Position.X, hrp.Position.Y, hrp.Position.Z)).Magnitude
                if dist > 6 then
                    hum:MoveTo(pos)
                else
                    travarPersonagem()
                    pegarOvoViaPrompt(pos)
                    task.wait(0.02)
                    pegarOvoViaPrompt(pos)
                    task.wait(0.02)
                    pegarOvoViaPrompt(pos)
                end
            end
        end
        RunService.Heartbeat:Wait()
    end
    return estaSegurandoOvo()
end

function rodarCicloMultiArea()
    Roubo.Running = true
    local cancelFn = function() return not Roubo.Enabled or not Roubo.Running end

    ligarAntiMorte()

    -- ✅ FORÇA usar a seleção travada (se existir)
    if Roubo.LockedUid then
        Roubo.SelectedUid = Roubo.LockedUid
        Roubo.SelectedCat = Roubo.LockedCat
    end

    if not Roubo.SelectedUid then
        local lista = listEggs(false)
        if #lista > 0 then
            Roubo.SelectedUid = lista[1].uid
            Roubo.SelectedCat = lista[1].cat
        end
    end

    local target = acharOvoPorUid(Roubo.SelectedUid)
    if not target or not target.pos then
        desligarAntiMorte()
        Roubo.Running = false
        return
    end

    if not pegarOvoSemParar(target, cancelFn) then
        desligarAntiMorte()
        Roubo.Running = false
        return
    end

    if not teleportarNormal(POS_NOVA, cancelFn) then
        desligarAntiMorte()
        Roubo.Running = false
        return
    end
    task.wait(0.15)

    local ovosAntes = {}
    for _, e in ipairs(listEggs(false)) do ovosAntes[e.uid] = true end
    droparOvo()
    task.wait(0.3)

    local uidDropado = nil
    for _, e in ipairs(listEggs(false)) do
        if not ovosAntes[e.uid] then uidDropado = e.uid break end
    end

    desligarAntiMorte()

    local treadmillPos = acharEsteiraPosicao()
    if treadmillPos then
        local c = LocalPlayer.Character
        if c then
            pcall(function()
                c:PivotTo(CFrame.new(treadmillPos.X, treadmillPos.Y + 3, treadmillPos.Z))
            end)
        end
        local tTrava = os.clock()
        while os.clock() - tTrava < 2.0 do
            if cancelFn() then break end
            local cAtual = LocalPlayer.Character
            if cAtual then
                pcall(function()
                    cAtual:PivotTo(CFrame.new(treadmillPos.X, treadmillPos.Y + 3, treadmillPos.Z))
                end)
                local hrpAtual = cAtual:FindFirstChild("HumanoidRootPart")
                if hrpAtual then
                    hrpAtual.AssemblyLinearVelocity = Vector3.zero
                    hrpAtual.AssemblyAngularVelocity = Vector3.zero
                end
            end
            RunService.Heartbeat:Wait()
        end
        sairDaEsteira(treadmillPos)
    end

    if not teleportarNormal(POS_NOVA, cancelFn) then
        desligarAntiMorte()
        Roubo.Running = false
        return
    end
    task.wait(0.15)
    ligarAntiMorte()

    if uidDropado then
        if not pegarUidEspecifico(uidDropado, target, cancelFn, 15) then
            desligarAntiMorte()
            Roubo.Running = false
            return
        end
        -- ✅ NÃO sobrescreve a seleção do jogador
        target.uid = uidDropado
        target.pos = nil
    else
        if not pegarOvoSemParar(target, cancelFn) then
            desligarAntiMorte()
            Roubo.Running = false
            return
        end
    end

    task.wait(0.2)
    if not estaSegurandoOvo() then
        desligarAntiMorte()
        Roubo.Running = false
        return
    end

    if not teleportarNormal(AREA_SAFE, cancelFn) then
        desligarAntiMorte()
        Roubo.Running = false
        return
    end
    task.wait(0.15)

    desligarAntiMorte()
    Roubo.Running = false
end

