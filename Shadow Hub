local function acharEsteiraPosicao()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end

    local mySlot
    local shared = ReplicatedStorage:FindFirstChild("Shared")
    local remotes = shared and shared:FindFirstChild("Remotes")

    if remotes and remotes:IsA("ModuleScript") then
        local ok, result = pcall(require, remotes)
        if ok and result then
            remotes = result
        end
    end

    if type(remotes) == "table" and remotes.Homestead and remotes.Homestead.AskState then
        local ok, state = pcall(function()
            return remotes.Homestead.AskState:InvokeServer()
        end)

        if ok and type(state) == "table" and type(state.OwnersBySlot) == "table" then
            for slot, userId in pairs(state.OwnersBySlot) do
                if tostring(userId) == tostring(localPlayer.UserId) then
                    mySlot = tostring(slot)
                    break
                end
            end
        end
    end

    if not mySlot then return nil end

    local plot = plots:FindFirstChild(mySlot)
    if not plot then return nil end

    local treadmill = plot:FindFirstChild("TreadmillBottom", true)
    if treadmill and treadmill:IsA("BasePart") then
        return treadmill.Position
    end

    treadmill = plot:FindFirstChild("TreadmillUpgrade", true)
    if treadmill then
        local part
        if treadmill:IsA("BasePart") then
            part = treadmill
        else
            part = treadmill:FindFirstChildWhichIsA("BasePart", true)
        end
        if part then
            return part.Position
        end
    end

    return nil
end

local function sairDaEsteira(treadmillPos)
    local packages = ReplicatedStorage:FindFirstChild("Packages")
    local networking = packages and packages:FindFirstChild("Networking")
    local askDoff = networking and networking:FindFirstChild(
        "RF/Treadmill/AskDoff"
    )

    if askDoff then
        pcall(function()
            askDoff:InvokeServer()
        end)
    end

    local hum = getHum()
    if hum then
        pcall(function()
            hum.PlatformStand = false
            hum.Sit = false
            hum.Jump = true
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end)
    end

    task.wait(0.08)

    local hrp = getRoot()
    if hrp and treadmillPos then
        if (hrp.Position - treadmillPos).Magnitude < 6 then
            local longe = Vector3.new(
                treadmillPos.X + 15,
                treadmillPos.Y + 3,
                treadmillPos.Z
            )

            local char = localPlayer.Character
            if char then
                pcall(function()
                    char:PivotTo(CFrame.new(longe))
                end)
            end
        end
    end
end

-- ============================================================
-- MOVIMENTO DE SEGURANÇA
-- ============================================================

local ALTURA_SEGURA = 120
local TEMPO_SUBIDA = 0.12
local TEMPO_HORIZONTAL = 0.18
local TEMPO_DESCIDA = 0.12

local function cancelarMovimento(cancelFn)
    return cancelFn and cancelFn()
end

local function subirAteDestino(destino, cancelFn)
    local char = localPlayer.Character
    if not char then return false end

    local hrp = getRoot()
    if not hrp then return false end

    local inicio = hrp.Position

    local t0 = os.clock()
    while os.clock() - t0 < TEMPO_SUBIDA do
        if cancelarMovimento(cancelFn) then return false end

        local alpha = (os.clock() - t0) / TEMPO_SUBIDA
        local y = inicio.Y + (ALTURA_SEGURA - inicio.Y) * alpha

        pcall(function()
            char:PivotTo(CFrame.new(inicio.X, y, inicio.Z))
        end)

        RunService.Heartbeat:Wait()
    end

    local t1 = os.clock()
    while os.clock() - t1 < TEMPO_HORIZONTAL do
        if cancelarMovimento(cancelFn) then return false end

        local alpha = (os.clock() - t1) / TEMPO_HORIZONTAL
        local x = inicio.X + (destino.X - inicio.X) * alpha
        local z = inicio.Z + (destino.Z - inicio.Z) * alpha

        pcall(function()
            char:PivotTo(CFrame.new(x, ALTURA_SEGURA, z))
        end)

        RunService.Heartbeat:Wait()
    end

    local t2 = os.clock()
    while os.clock() - t2 < TEMPO_DESCIDA do
        if cancelarMovimento(cancelFn) then return false end

        local alpha = (os.clock() - t2) / TEMPO_DESCIDA
        local y = ALTURA_SEGURA + (destino.Y - ALTURA_SEGURA) * alpha

        pcall(function()
            char:PivotTo(CFrame.new(destino.X, y, destino.Z))
        end)

        RunService.Heartbeat:Wait()
    end

    pcall(function()
        char:PivotTo(CFrame.new(destino))
    end)

    return true
end

-- ============================================================
-- PEGAR UID ESPECÍFICO
-- ============================================================

local function pegarUidEspecifico(
    uidAlvo,
    target,
    cancelFn,
    timeout
)
    timeout = timeout or 8
    local inicio = os.clock()

    while os.clock() - inicio < timeout do
        if cancelFn() then return false end

        local carregando, carregadoUid = estaSegurandoOvo()

        if carregando then
            if not uidAlvo or not carregadoUid or tostring(carregadoUid) == tostring(uidAlvo) then
                return true
            end
        end

        local ovo = acharOvoPorUid(uidAlvo)

        if not ovo or not ovo.pos then
            local hrp = getRoot()
            if hrp and target and target.cat then
                local perto = acharOvoMesmoTipoPerto(
                    target.cat,
                    hrp.Position,
                    50
                )
                if perto then
                    ovo = perto
                    uidAlvo = perto.uid
                end
            end
        end

        if ovo and ovo.pos then
            local hum = getHum()
            local hrp = getRoot()

            if hum and hrp then
                local dist = (
                    Vector3.new(
                        ovo.pos.X,
                        hrp.Position.Y,
                        ovo.pos.Z
                    ) - hrp.Position
                ).Magnitude

                if dist > 5 then
                    hum:MoveTo(ovo.pos)
                else
                    while not cancelFn() and not estaSegurandoOvo() and os.clock() - inicio < timeout do
                        travarPersonagem()
                        pegarOvoViaPrompt(ovo.pos)
                        pegarOvoViaPrompt(ovo.pos)
                        pegarOvoViaPrompt(ovo.pos)
                        RunService.Heartbeat:Wait()
                    end

                    if estaSegurandoOvo() then
                        subirProCeu()
                        return true
                    end
                end
            end
        end

        RunService.Heartbeat:Wait()
    end

    return estaSegurandoOvo()
end

-- ============================================================
-- CICLO MULTI-ÁREA
-- ============================================================

function rodarCicloMultiArea()
    Roubo.Running = true
    local cycleVersion = Roubo.TargetVersion

    local cancelFn = function()
        if not Roubo.Enabled or not Roubo.Running then
            return true
        end
        if Roubo.TargetVersion ~= cycleVersion and not Carregando.IsCarrying then
            return true
        end
        return false
    end

    ligarAntiMorte()

    if Roubo.LockedUid then
        Roubo.SelectedUid = Roubo.LockedUid
        Roubo.SelectedCat = Roubo.LockedCat
    end

    if not Roubo.SelectedUid then
        local lista = listCampoEggs()
        if #lista > 0 then
            Roubo.SelectedUid = lista[1].uid
            Roubo.SelectedCat = lista[1].cat
            Roubo.LockedUid = lista[1].uid
            Roubo.LockedCat = lista[1].cat
        end
    end

    local target = acharOvoPorUid(Roubo.SelectedUid)

    if not target and Roubo.LockedCat then
        local hrp = getRoot()
        if hrp then
            local perto = acharOvoMesmoTipoPerto(Roubo.LockedCat, hrp.Position, 200)
            if perto then
                target = perto
                Roubo.SelectedUid = perto.uid
            end
        end
    end

    if not target then
        desligarAntiMorte()
        Roubo.Running = false
        return
    end

    local categoriaTravada = Roubo.LockedCat or target.cat

    local areaIndex, areaAtual = detectarAreaAtual()

    if not areaIndex then
        desligarAntiMorte()
        Roubo.Running = false
        return
    end

    if areaIndex == SAFE_INDEX then
        desligarAntiMorte()
        Roubo.Running = false
        return
    end

    if not pegarOvoSemParar(target, cancelFn) then
        desligarAntiMorte()
        Roubo.Running = false
        return
    end

    areaIndex, areaAtual = detectarAreaAtual()

    if not areaIndex then
        desligarAntiMorte()
        Roubo.Running = false
        return
    end

    local lastDestinoIndex = nil

    while Roubo.Enabled and not cancelFn() do
        local currentIndex

        if lastDestinoIndex then
            currentIndex = lastDestinoIndex
            lastDestinoIndex = nil
        else
            currentIndex = detectarAreaAtual()
        end

        if not currentIndex then break end
        if currentIndex == SAFE_INDEX then break end

        local destinoIndex, destino = proximoDestino(currentIndex)
        if not destino then break end

        if not subirAteDestino(destino.pos, cancelFn) then break end

        -- ⚡ DELAY CURTO ANTES DE DROPAR
        task.wait(0.15)

        if destinoIndex == SAFE_INDEX then break end

        if not estaSegurandoOvo() then break end

        -- ⚡ TRAVA NO DESTINO SÓ 3 FRAMES
        local charDrop = localPlayer.Character
        local humDrop = getHum()
        local hrpDrop = getRoot()

        if charDrop and humDrop and hrpDrop then
            pcall(function()
                charDrop:PivotTo(CFrame.new(destino))
            end)

            pcall(function()
                hrpDrop.AssemblyLinearVelocity = Vector3.zero
                hrpDrop.AssemblyAngularVelocity = Vector3.zero
                humDrop:Move(Vector3.zero, false)
                humDrop:MoveTo(destino)
            end)

            for _ = 1, 3 do
                pcall(function()
                    charDrop:PivotTo(CFrame.new(destino))
                end)

                local h = getRoot()
                if h then
                    pcall(function()
                        h.AssemblyLinearVelocity = Vector3.zero
                        h.AssemblyAngularVelocity = Vector3.zero
                    end)
                end

                RunService.Heartbeat:Wait()
            end
        end

        local hrpAntesDrop = getRoot()
        local posDrop = hrpAntesDrop and hrpAntesDrop.Position

        local ovosAntes = {}
        for _, egg in ipairs(listEggs()) do
            ovosAntes[egg.uid] = true
        end

        local _, uidCarregando = estaSegurandoOvo()

        -- ⚡ DROPA IMEDIATAMENTE
        droparOvo()

        -- ⚡ SÓ 2 FRAMES DEPOIS DO DROP
        local charDepois = localPlayer.Character
        if charDepois and posDrop then
            for _ = 1, 2 do
                local humAtual = getHum()
                if humAtual then
                    pcall(function()
                        humAtual:Move(Vector3.zero, false)
                        humAtual:MoveTo(posDrop)
                    end)
                end
                pcall(function()
                    charDepois:PivotTo(CFrame.new(posDrop))
                end)
                RunService.Heartbeat:Wait()
            end
        end

        local uidDropado

        -- ⚡ TIMEOUT 0.5s PRA ACHAR O UID
        if uidCarregando then
            local tentativa = os.clock()
            while not uidDropado and os.clock() - tentativa < 0.5 do
                if acharOvoPorUid(uidCarregando) then
                    uidDropado = uidCarregando
                    break
                end
                task.wait(0.01)
            end
        end

        if not uidDropado then
            local tentativa = os.clock()
            while not uidDropado and os.clock() - tentativa < 0.5 do
                for _, egg in ipairs(listEggs()) do
                    if not ovosAntes[egg.uid] then
                        uidDropado = egg.uid
                        break
                    end
                end
                if not uidDropado then
                    task.wait(0.01)
                end
            end
        end

        -- ⚡ FALLBACK POR POSIÇÃO: 0.3s, raio 15
        if not uidDropado and posDrop then
            local tentativa = os.clock()
            while not uidDropado and os.clock() - tentativa < 0.3 do
                local maisPerto
                local menorDist = 15

                for _, egg in ipairs(listEggs()) do
                    if egg.cat == categoriaTravada and egg.pos and not egg.isBase then
                        local dist = (egg.pos - posDrop).Magnitude
                        if dist < menorDist then
                            menorDist = dist
                            maisPerto = egg
                        end
                    end
                end

                if maisPerto then
                    uidDropado = maisPerto.uid
                    break
                end

                task.wait(0.01)
            end
        end

        local pegou = false

        -- ⚡ TIMEOUT 2s PRA PEGAR
        if uidDropado then
            pegou = pegarUidEspecifico(uidDropado, target, cancelFn, 2)
            if pegou then
                target.uid = uidDropado
                Roubo.SelectedUid = uidDropado
            end
        end

        if not pegou then
            pegou = pegarQualquerDoTipo(categoriaTravada, cancelFn, 2)
        end

        if not pegou then
            break
        end

        lastDestinoIndex = destinoIndex

        task.wait(0.02)
    end

    desligarAntiMorte()
    Roubo.Running = false
end

-- ============================================================
-- ANTI-TRAP
-- ============================================================

local canTouchOriginais = {}
local antiTrapConnections = {}

local function desativarTouch(inst)
    if not Config.AntiTrap then return end
    if inst:IsA("BasePart") and canTouchOriginais[inst] == nil then
        canTouchOriginais[inst] = inst.CanTouch
        pcall(function() inst.CanTouch = false end)
    end
end

local function processarTrap(trap)
    if not Config.AntiTrap or not trap then return end
    desativarTouch(trap)
    for _, d in ipairs(trap:GetDescendants()) do
        desativarTouch(d)
    end
end

local function ligarAntiTrap()
    for _, trap in ipairs(CollectionService:GetTagged("PlacedTrap")) do
        processarTrap(trap)
    end

    if not antiTrapConnections.added then
        antiTrapConnections.added = CollectionService:GetInstanceAddedSignal("PlacedTrap"):Connect(function(trap)
            task.defer(function()
                if Config.AntiTrap then processarTrap(trap) end
            end)
        end)
    end

    if not antiTrapConnections.descendant then
        antiTrapConnections.descendant = workspace.DescendantAdded:Connect(function(d)
            if not Config.AntiTrap then return end
            local parentObj = d.Parent
            while parentObj do
                if parentObj:HasTag("PlacedTrap") then
                    desativarTouch(d)
                    break
                end
                parentObj = parentObj.Parent
            end
        end)
    end
end

local function desligarAntiTrap()
    for instance, original in pairs(canTouchOriginais) do
        if instance and instance.Parent and instance:IsA("BasePart") then
            pcall(function() instance.CanTouch = original end)
        end
        canTouchOriginais[instance] = nil
    end

    for key, conn in pairs(antiTrapConnections) do
        pcall(function() conn:Disconnect() end)
        antiTrapConnections[key] = nil
    end
end

local function setAntiTrap(enabled)
    Config.AntiTrap = enabled
    if enabled then
        ligarAntiTrap()
    else
        desligarAntiTrap()
    end
end

